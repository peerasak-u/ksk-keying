# Copy to .env (gitignored) and fill in. Unlike the old ksk-console service
# (removed), this app has no mock mode — every stage shells out to a real
# `claude -p`, so the two mounts below are not optional. See
# docker-compose.yml and README.md.

# UID=1000
# GID=1000
# HOST_HOME=/home/peerasak
# ^ required for the credential mounts — set explicitly rather than relying on
#   shell $HOME, which resolves to /root under `sudo docker ...`

# KSK_APP_WORKSPACE_ROOT_HOST=/home/peerasak/Dropbox/สารบัญงานบัญชี_For Ton/samples/clients
# ^ required, no default: the root whose level-1 dirs are clients and level-2
#   dirs are months. `compose up` fails loudly if this is unset.
# KSK_APP_SKILLS_HOST=/home/peerasak/Dropbox/สารบัญงานบัญชี_For Ton/.claude
# ^ required in practice: the install root's .claude/ (skills + agents).
#   Without it /ksk-keying is genuinely unknown to the CLI inside the
#   container and every stage no-ops instantly, misreported as a clean
#   "done". Point it at whichever .claude/ actually owns the /ksk-keying
#   skill for the workspace above (the dev repo's own .claude/ for
#   samples/clients, or the Dropbox install's .claude/ for a real client
#   workspace — see the root CLAUDE.md's two deployment copies).

# KSK_APP_PORT=8940
# KSK_APP_HOST=0.0.0.0
# KSK_APP_CONCURRENCY=1

# Container resource failsafes — see docker-compose.yml for why these exist
# (the Pi host has been OOM-killed in practice).
# KSK_APP_CPUS=2.0
# KSK_APP_MEM=3g
# KSK_APP_MEM_RESERVATION=1g
